# Backend caregivers (FastAPI). En dev suele ser http://localhost:8000.
VITE_API_URL=http://localhost:8000

# Supabase — mismo proyecto que el backend y el móvil.
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Versión de la política de privacidad vigente en el backend.
# Debe coincidir con `POLICY_VERSION` del backend o todo cae en 409.
VITE_POLICY_VERSION=2026-09-11
